# Ambiente ativo: "development" usa as variáveis *_DEV; "production" usa as sem sufixo.
APP_ENV=development

# --- Desenvolvimento (projeto Supabase: pampa-zoonoses-dev) ---
SUPABASE_URL_DEV=https://SEU-REF-DEV.supabase.co
SUPABASE_KEY_DEV=

# --- Produção (projeto Supabase: pampa-zoonoses) ---
SUPABASE_URL=https://SEU-REF-PROD.supabase.co
SUPABASE_KEY=

# --- Django ---
# Obrigatória em produção.
DJANGO_SECRET_KEY=
# Padrão: True em development, False em production.
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origens do front-end (separadas por vírgula). Em development, vazio = libera todas.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Limite de requisições por IP.
THROTTLE_RATE=120/min
